# Variables lues depuis l'environnement : les exporter dans le shell avant
# de lancer les scripts (le fichier n'est pas chargé automatiquement).
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=stocksense
MONGO_TIMEOUT_MS=3000
# Base utilisée par les tests d'intégration (une base jetable y est créée puis supprimée)
MONGO_TEST_URI=mongodb://localhost:27017/
